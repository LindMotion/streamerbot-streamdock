      "PropertyInspectorPath": "propertyInspector/index.html",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": true,
      "SupportedInMultiActions": false,
      "States": [
        { "Image": "imgs/connection.png", "TitleAlignment": "bottom", "FontSize": "9" }
